# Unipocket 백엔드 배포용 환경변수 템플릿
# 이 파일을 같은 디렉토리에 .env 로 복사한 뒤 <...> 자리를 실제 값으로 채운다.
# .env 는 gitignore 되어 있으므로 절대 커밋하지 않는다. 실제 값은 팀 내부 채널로 공유.

### MySQL (docker-compose 내부 컨테이너) ###
MYSQL_ROOT_PASSWORD=<mysql-root-password>
DB_URL=jdbc:mysql://mysql:3306/unipocket?serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=unipocket
DB_PASSWORD=<mysql-user-password>
JPA_DDL_AUTO=update

### Redis (docker-compose 내부 컨테이너) ###
REDIS_HOST=redis
REDIS_PORT=6379

### 스토리지 — GCS 버킷을 S3 호환 API로 사용 ###
# HMAC 키는 GCP Console > Cloud Storage > 설정 > 상호운용성 탭에서 발급 (사용자 계정 키)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=unipocket-media-5ba3282c
AWS_ACCESS_KEY_ID=<gcs-hmac-access-key>
AWS_SECRET_ACCESS_KEY=<gcs-hmac-secret>
SPRING_CLOUD_AWS_S3_ENDPOINT=https://storage.googleapis.com
SPRING_CLOUD_AWS_S3_PATH_STYLE_ACCESS_ENABLED=true

### JWT ###
JWT_SECRET=<base64-encoded-256bit-secret>
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d
JWT_OAUTH_STATE_TTL=10m

### OAuth — 콘솔(Google Cloud / Kakao Developers)에도 동일한 redirect URI 등록 필요 ###
GOOGLE_OAUTH_ID=<google-oauth-client-id>
GOOGLE_OAUTH_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://unipocket-ashy.vercel.app/api/auth/oauth2/callback/google
KAKAO_OAUTH_ID=<kakao-rest-api-key>
KAKAO_OAUTH_SECRET=<kakao-client-secret>
KAKAO_REDIRECT_URI=https://unipocket-ashy.vercel.app/api/auth/oauth2/callback/kakao

### 미디어 presigned URL (초 단위) ###
MEDIA_GET_EXPIRATION=600
MEDIA_PUT_EXPIRATION=600
MEDIA_CLEANUP_CRON=0 0 4 * * *

### 프론트엔드 / CORS / 쿠키 ###
# 프론트(Vercel)와 백엔드(sslip.io) 도메인이 달라 크로스 사이트 쿠키가 필요 → SameSite=None
# COOKIE_DOMAIN 은 비워두면 host-only 쿠키(백엔드 도메인)로 발급됨
FRONTEND_URL=https://unipocket-ashy.vercel.app
FRONTEND_ALLOWED_ORIGINS=https://unipocket-ashy.vercel.app,http://localhost:5173,https://34.64.82.85.sslip.io
COOKIE_DOMAIN=
COOKIE_SAME_SITE=None

### 로깅 ###
LOG_PATH=/var/log/unipocket
LOG_LEVEL=INFO

### 환율 — Yahoo Finance ###
# 데이터센터 IP에서 query1 호스트가 차단되어 query2 사용 (트러블슈팅 참고)
EXCHANGE_YAHOO_CHARTURL=https://query2.finance.yahoo.com/v8/finance/chart/{symbol}

### Gemini (영수증 파싱) ###
# AI Studio에서 발급한 키 사용. gemini-2.5-flash 권장
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

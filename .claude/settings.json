{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh",
            "timeout": 10,
            "statusMessage": "위험 명령 검사 중..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-before-commit.sh",
            "timeout": 120,
            "statusMessage": "커밋 전 lint 검사 중..."
          }
        ]
      }
    ]
  }
}
